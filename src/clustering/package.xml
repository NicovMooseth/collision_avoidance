<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- Package manifest: name, description and ALL dependencies.
     Every package used in CMakeLists.txt (find_package) needs a <depend> here (rosdep key). -->
<package format="3">
  <name>clustering</name>
  <version>0.1.0</version>
  <description>Obstacles of the offline map and of the LiDAR scans: map / LiDAR obstacle types, map loading, DBSCAN clustering and clustering_node.</description>
  <maintainer email="nico@von-moos.org">nico</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>eigen</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>generate_parameter_library</depend>
  <depend>pcd_constraints</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
